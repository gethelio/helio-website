# ===========================================
# Helio Website Environment Variables
# ===========================================

# Resend (https://resend.com) — design partner emails
RESEND_API_KEY=re_your-resend-key-here

# Design partner form
# From address must be on a Resend-verified domain with SPF + DKIM.
DESIGN_PARTNER_FROM_EMAIL=Helio <hello@helio.so>
DESIGN_PARTNER_NOTIFY_EMAIL=hello@helio.so

# Google Sheet for design partner submissions (service account).
# 1. Create a Google Cloud project, enable the Sheets API, create a service account.
# 2. Download the JSON key. Share the sheet with the service account email as Editor.
# 3. First tab named Submissions (or set GOOGLE_SHEETS_TAB). Row 1 headers are written automatically.
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id
GOOGLE_SHEETS_TAB=Submissions
GOOGLE_SERVICE_ACCOUNT_EMAIL=helio-forms@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Analytics (Optional)
# Google Analytics 4 - https://analytics.google.com
# Get your Measurement ID from: Admin > Data Streams > your stream
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
