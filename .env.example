RESEND_API_KEY=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Agent Incident Log dataset. Defaults to the published dist/incidents.json on
# the data repo's main branch. Point at a local checkout to develop offline:
#   INCIDENT_DATA_URL=file:///path/to/agent-incident-log/dist/incidents.json
# Note that a file:// source bypasses fetch, so it is not cached and cannot be
# revalidated through the endpoint below.
INCIDENT_DATA_URL=

# Shared secret guarding /api/revalidate-incidents, which purges the cached
# dataset when the data repo publishes. Generate with `openssl rand -hex 32`.
# The data repo stores the full URL, secret included, as INCIDENT_REVALIDATE_URL
# (named VERCEL_DEPLOY_HOOK_URL until August 2026, which described an approach
# that was tried and does not work — see the route's comment):
#   https://<canonical-host>/api/revalidate-incidents?secret=...
# Use whichever of helio.so and www.helio.so answers without redirecting — check
# with `curl -sI`. curl neither follows a redirect by default nor fails on one,
# so the redirecting host silently reaches nothing.
# If unset, the endpoint refuses every request rather than falling open.
INCIDENT_REVALIDATE_SECRET=
