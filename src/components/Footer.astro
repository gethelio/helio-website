---
import { SITE_SOCIAL_LINKEDIN, SITE_SOCIAL_TWITTER, SITE_GITHUB } from '../const'
import Logo from './Logo.astro'

const currentYear = new Date().getFullYear()
---

<footer class="w-full bg-gray-50 pt-16">
    <div class="mx-auto max-w-7xl px-6 sm:px-12 lg:px-28">
        <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr_1fr]">
            <!-- Column 1: Helio -->
            <div class="space-y-4">
                <a href="/" aria-label="Go home" class="inline-flex items-center gap-2">
                    <Logo />
                    <span class="text-lg font-semibold text-gray-900">Helio</span>
                </a>
                <p class="text-sm leading-relaxed text-gray-500">Open-source governance for MCP tool calls. Put policy, spend limits, approvals, and an audit trail between your agents and the systems they can change.</p>
                <div class="flex items-center gap-3">
                    <a href={SITE_SOCIAL_TWITTER} target="_blank" rel="noopener noreferrer" aria-label="X/Twitter" class="text-gray-400 transition-colors hover:text-gray-600">
                        <svg class="size-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
                        </svg>
                    </a>
                    <a href={SITE_SOCIAL_LINKEDIN} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="text-gray-400 transition-colors hover:text-gray-600">
                        <svg class="size-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
                        </svg>
                    </a>
                    <a href={SITE_GITHUB} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="text-gray-400 transition-colors hover:text-gray-600">
                        <svg class="size-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path
                                d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.17 6.839 9.49.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.342-3.369-1.342-.454-1.157-1.11-1.465-1.11-1.465-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.167 22 16.418 22 12c0-5.523-4.477-10-10-10z"
                            ></path>
                        </svg>
                    </a>
                </div>
            </div>

            <!-- Column 2: Company -->
            <div>
                <h3 class="mb-4 text-sm font-semibold text-gray-900">Company</h3>
                <ul class="space-y-3 text-sm">
                    <li><a href="/about/" class="text-gray-500 transition-colors hover:text-main-500">About</a></li>
                    <li><a href="/about/#contact" class="text-gray-500 transition-colors hover:text-main-500">Contact</a></li>
                </ul>
            </div>

            <!-- Column 3: Platform -->
            <div>
                <h3 class="mb-4 text-sm font-semibold text-gray-900">Product</h3>
                <ul class="space-y-3 text-sm">
                    <li><a href="/#features" class="text-gray-500 transition-colors hover:text-main-500">Features</a></li>
                    <li><a href="/#how-it-works" class="text-gray-500 transition-colors hover:text-main-500">How it works</a></li>
                    <li><a href="/#pricing" class="text-gray-500 transition-colors hover:text-main-500">Pricing</a></li>
                </ul>
            </div>

            <!-- Column 4: Resources -->
            <div>
                <h3 class="mb-4 text-sm font-semibold text-gray-900">Resources</h3>
                <ul class="space-y-3 text-sm">
                    <li><a href="/blog/" rel="noopener noreferrer" class="text-gray-500 transition-colors hover:text-main-500">Blog</a></li>
                    <li><a href="https://github.com/gethelio/helio/tree/main/docs" target="_blank" rel="noopener noreferrer" class="text-gray-500 transition-colors hover:text-main-500">Documentation</a></li>
                    <li><a href="/#faq" class="text-gray-500 transition-colors hover:text-main-500">FAQ</a></li>
                </ul>
            </div>
        </div>

        <!-- Bottom bar -->
        <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-gray-200 py-6 text-xs text-gray-400 sm:flex-row">
            <span>© {currentYear} Helio Ltd. All rights reserved.</span>
            <div class="flex items-center gap-1.5">
                <a href="/privacy-policy/" class="transition-colors hover:text-main-500">Privacy Policy</a>
                <span>·</span>
                <a href="/terms-of-service/" class="transition-colors hover:text-main-500">Terms of Service</a>
            </div>
        </div>
    </div>

    <!-- Large logo watermark -->
    <div class="relative mx-auto h-20 max-w-4xl overflow-hidden before:absolute before:inset-0 before:bg-gradient-to-t before:from-gray-50 before:to-transparent sm:h-36">
        <svg width="810" height="200" viewBox="0 0 810 200" fill="none" xmlns="http://www.w3.org/2000/svg">
            <text x="50%" y="55%" dominant-baseline="middle" text-anchor="middle" font-family="'Bricolage Grotesque', system-ui, sans-serif" font-size="180" font-weight="600" fill="url(#paint0_linear_footer)">Helio</text>
            <defs>
                <linearGradient id="paint0_linear_footer" x1="405" y1="0" x2="405" y2="200" gradientUnits="userSpaceOnUse">
                    <stop offset="0" stop-color="#B0B0B0"></stop>
                    <stop offset="0.7" stop-color="#D0D0D0"></stop>
                    <stop offset="1" stop-color="#F9FAFB" stop-opacity="0"></stop>
                </linearGradient>
            </defs>
        </svg>
    </div>
</footer>
