---
// Lightweight GDPR-compliant cookie consent banner
// Stores preference in localStorage, controls GA4 via Consent Mode v2
---

<div
  id="cookie-consent-banner"
  class="fixed bottom-0 left-0 right-0 z-[60] translate-y-full transition-transform duration-300 ease-out"
  role="dialog"
  aria-label="Cookie consent"
>
  <div class="mx-auto max-w-2xl px-4 pb-4">
    <div class="rounded-xl border border-gray-200 bg-white p-4 shadow-lg dark:border-gray-800 dark:bg-gray-900 sm:flex sm:items-center sm:gap-4 sm:p-5">
      <div class="flex-1 text-sm text-gray-600 dark:text-gray-400">
        <p>
          We use cookies for analytics to understand how you use our site and improve your experience.
          <a href="/privacy-policy/" class="underline hover:text-gray-900 dark:hover:text-gray-200">Privacy policy</a>
        </p>
      </div>
      <div class="mt-3 flex shrink-0 gap-2 sm:mt-0">
        <button
          id="cookie-reject-btn"
          type="button"
          class="rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 transition-colors hover:bg-gray-50 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800"
        >
          Decline
        </button>
        <button
          id="cookie-accept-btn"
          type="button"
          class="rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-gray-800 dark:bg-white dark:text-gray-900 dark:hover:bg-gray-100"
        >
          Accept
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { getConsent, setConsent } from '@/lib/analytics/consent'

  const banner = document.getElementById('cookie-consent-banner') as HTMLDivElement
  const acceptBtn = document.getElementById('cookie-accept-btn') as HTMLButtonElement
  const rejectBtn = document.getElementById('cookie-reject-btn') as HTMLButtonElement

  // Only show if no decision has been made
  const existing = getConsent()
  if (!existing) {
    // Small delay so page finishes rendering first
    setTimeout(() => {
      banner.classList.remove('translate-y-full')
    }, 800)
  }

  const hideBanner = () => {
    banner.classList.add('translate-y-full')
    // Remove from DOM after animation
    setTimeout(() => {
      banner.remove()
    }, 300)
  }

  acceptBtn.addEventListener('click', () => {
    setConsent('granted')
    hideBanner()
  })

  rejectBtn.addEventListener('click', () => {
    setConsent('denied')
    hideBanner()
  })
</script>
