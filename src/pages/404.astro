---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Page Not Found | Helio" description="The page you're looking for doesn't exist or has been moved." noindex={true}>
    <main class="flex flex-1 items-center justify-center px-6 pb-24 pt-32 sm:pb-0">
        <div class="mx-auto max-w-lg px-6 text-center">
            <p class="text-title mt-20 text-6xl font-bold sm:text-8xl">404</p>
            <h1 class="text-title mt-4 text-2xl font-semibold sm:text-3xl">Page not found</h1>
            <p class="mt-4 text-gray-600">The page you're looking for doesn't exist or has been moved.</p>
            <div class="mb-80 mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
                <a href="/" class="rounded-full bg-gray-900 px-6 py-2.5 text-sm font-medium text-white transition-colors hover:bg-gray-800">Go home</a>
                <a href="/blog/" class="rounded-full border border-gray-200 px-6 py-2.5 text-sm font-medium text-gray-700 transition-colors hover:bg-gray-50">Read the blog</a>
            </div>
        </div>
    </main>
</Layout>

<style is:global>
    /* Make body flex column for this page only */
    body:has(main.flex-1) {
        display: flex;
        flex-direction: column;
        min-height: 100dvh;
    }
</style>
