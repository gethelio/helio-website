---
import { type CollectionEntry, getCollection, render } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import { SITE_GITHUB, SITE_IMAGE, SITE_URL } from '../../const'
import CopyInstallCommand, { INSTALL_COMMAND } from '../../components/CopyInstallCommand.astro'
import { buttonVariants } from '@/components/ui/button'
import { blogSlug } from '../../content.config'
import '../../styles/blog/shared.css'
import '../../styles/blog/article.css'

export async function getStaticPaths() {
    const posts = await getCollection('blog')
    return posts.map((post) => ({
        params: { slug: blogSlug(post) },
        props: post,
    }))
}

type Props = CollectionEntry<'blog'>

const post = Astro.props
const { Content, headings } = await render(post)
const seoTitle = post.data.seoTitle ?? post.data.title
const metaDescription = post.data.metaDescription ?? post.data.description
const slug = blogSlug(post)

const tocHeadings = headings.filter((h) => h.depth === 2)

const wordsPerMinute = 200
const wordCount = (post.body ?? '').split(/\s+/g).filter(Boolean).length
const readTime = Math.ceil(wordCount / wordsPerMinute)

const authors: Record<string, { title: string; bio: string; link: string }> = {
    'Oli Guei': {
        title: 'Founder, Helio',
        bio: 'Founder of Helio. Writing about governing agents that can actually do things: policy, spend, evidence, and the incidents we keep a public record of.',
        link: 'https://x.com/oliguei',
    },
}

const authorInfo = authors[post.data.author] || {
    title: 'Helio',
    bio: 'Writing about governing agents that can actually do things: policy, spend, evidence, and the incidents we keep a public record of.',
    link: SITE_URL,
}

const initials = (name: string) =>
    name
        .split(/\s+/)
        .map((part) => part[0])
        .join('')
        .slice(0, 2)
        .toUpperCase()

const catClass = (category: string) => `blog-cat-${category.toLowerCase()}`
const categoriesFor = (entry: CollectionEntry<'blog'>) => entry.data.categories ?? [entry.data.category]
const postCategories = categoriesFor(post)

const topicDot: Record<string, string> = {
    Guide: '#175CD3',
    Governance: '#7C3AED',
    Security: '#DC2626',
    MCP: '#0891B2',
    Agent: '#067647',
}

const formatDate = (date: Date) => date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })

const pageUrl = Astro.url.href
const pageTitle = encodeURIComponent(post.data.title)
const shareUrls = {
    linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`,
    twitter: `https://twitter.com/intent/tweet?text=${pageTitle}&url=${encodeURIComponent(pageUrl)}`,
    email: `mailto:?subject=${pageTitle}&body=${encodeURIComponent(`Check out this article: ${pageUrl}`)}`,
}

const allPosts = await getCollection('blog')
const relatedPosts = allPosts
    .filter((p) => blogSlug(p) !== slug && categoriesFor(p).some((category) => postCategories.includes(category)))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 3)

const additionalPosts =
    relatedPosts.length < 3
        ? allPosts
              .filter((p) => blogSlug(p) !== slug && !relatedPosts.some((rp) => blogSlug(rp) === blogSlug(p)))
              .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
              .slice(0, 3 - relatedPosts.length)
        : []

const displayPosts = [...relatedPosts, ...additionalPosts]

const ogImage = post.data.heroImage || SITE_IMAGE

const blogPostingSchema = {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    inLanguage: 'en',
    headline: post.data.title,
    description: metaDescription,
    image: `${SITE_URL}${ogImage}`,
    datePublished: post.data.pubDate.toISOString(),
    dateModified: post.data.updatedDate?.toISOString() || post.data.pubDate.toISOString(),
    author: {
        '@type': 'Person',
        '@id': `${SITE_URL}/#author-${post.data.author.toLowerCase().replace(/\s+/g, '-')}`,
        name: post.data.author,
        url: authorInfo.link,
    },
    publisher: {
        '@id': `${SITE_URL}/#organization`,
    },
    mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': `${SITE_URL}/blog/${slug}/`,
    },
    wordCount: wordCount,
    articleSection: postCategories,
    keywords: postCategories.join(', '),
    articleBody: (post.body ?? '').substring(0, 5000),
}

const breadcrumbSchema = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE_URL}/blog/` },
        { '@type': 'ListItem', position: 3, name: post.data.title, item: `${SITE_URL}/blog/${slug}/` },
    ],
}

---

<Layout title={`${seoTitle} | Helio`} description={metaDescription} image={ogImage} ogType="article">
    <Fragment slot="head">
        <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
        <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    </Fragment>

    <main class="article-post duration-150">
        <section class="relative mx-auto max-w-6xl px-3 pt-32 sm:pt-36">
            <div class="relative px-4 pb-10 pt-6 sm:px-8 sm:pb-12 sm:pt-8 md:px-12">
                <div class="article-hero-dots pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
                <nav aria-label="Breadcrumb">
                    <ol class="article-crumb">
                        <li><a href="/">Home</a></li>
                        <li class="article-crumb-sep" aria-hidden="true">/</li>
                        <li><a href="/blog/">Blog</a></li>
                        <li class="article-crumb-sep" aria-hidden="true">/</li>
                        <li class="article-crumb-current">{post.data.title}</li>
                    </ol>
                </nav>
                <p class="mb-3 font-mono text-[10px] font-medium uppercase tracking-[0.12em] text-main-500">Writing</p>
                <h1 class="text-title text-4xl font-semibold tracking-tight sm:text-6xl">{post.data.title}</h1>
                <p class="text-body mt-4 text-[17px] leading-relaxed">{post.data.description}</p>
                <div class="mt-7 flex flex-wrap items-center gap-x-[18px] gap-y-3.5">
                    <span class="blog-author">
                        {
                            post.data.authorImage ? (
                                <img class="blog-avatar" src={post.data.authorImage} alt="" width="22" height="22" decoding="async" />
                            ) : (
                                <span class="blog-avatar" aria-hidden="true">
                                    {initials(post.data.author)}
                                </span>
                            )
                        }
                        {post.data.author}
                    </span>
                    <time class="font-mono text-[11px] tracking-wide text-gray-500" datetime={post.data.pubDate.toISOString()}>
                        {formatDate(post.data.pubDate)}
                    </time>
                    <span class="font-mono text-[11px] tracking-wide text-gray-500">{readTime} min read</span>
                    <span class="blog-tags">
                        {
                            postCategories.map((category) => (
                                <span class:list={['blog-tag', catClass(category)]}>
                                    <i style={`background-color:${topicDot[category] ?? '#a1a1aa'}`} />
                                    {category}
                                </span>
                            ))
                        }
                    </span>
                </div>
            </div>
        </section>

        <div aria-hidden="true" class="border-t border-gray-200"></div>

        <section class="relative mx-auto max-w-6xl border-x px-3">
            <div class="border-x">
                {
                    post.data.heroImage && (
                        <figure class="article-hero-figure m-0">
                            <img src={post.data.heroImage} alt={post.data.heroImageAlt || post.data.title} width={1200} height={630} decoding="async" />
                        </figure>
                    )
                }
                <div class="article-grid">
                    <article class="article-prose">
                        <Content />
                        <div class="article-byline">
                            {
                                post.data.authorImage ? (
                                    <img class="article-byline-avatar" src={post.data.authorImage} alt="" width="40" height="40" loading="lazy" decoding="async" />
                                ) : (
                                    <span class="article-byline-avatar" aria-hidden="true">
                                        {initials(post.data.author)}
                                    </span>
                                )
                            }
                            <div>
                                <p class="article-byline-name">{post.data.author}</p>
                                <p>{authorInfo.bio}</p>
                            </div>
                        </div>
                    </article>

                    <aside class="article-toc" aria-label="On this page">
                        {
                            tocHeadings.length > 0 && (
                                <div class="article-toc-nav">
                                    <h2>On this page</h2>
                                    {tocHeadings.map((heading) => (
                                        <a href={`#${heading.slug}`} class="toc-link">
                                            {heading.text}
                                        </a>
                                    ))}
                                </div>
                            )
                        }
                        <div class="article-share">
                            <h2>Share</h2>
                            <div class="article-share-row">
                                <a class="article-share-btn" href={shareUrls.twitter} target="_blank" rel="noopener noreferrer" aria-label="Share on X">
                                    <svg width="13" height="13" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
                                    </svg>
                                </a>
                                <a class="article-share-btn" href={shareUrls.linkedin} data-share="linkedin" aria-label="Share on LinkedIn">
                                    <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                        <path
                                            d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                                        ></path>
                                    </svg>
                                </a>
                                <a class="article-share-btn" href={shareUrls.email} aria-label="Share via email">
                                    <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"></path>
                                    </svg>
                                </a>
                            </div>
                        </div>
                    </aside>
                </div>
            </div>
        </section>

        {
            displayPosts.length > 0 && (
                <section class="relative mx-auto max-w-6xl border-x px-3">
                    <div class="border-x border-t">
                        <div class="px-4 pb-5 pt-7 sm:px-8">
                            <h2 class="font-mono text-[13px] font-medium uppercase tracking-[0.12em] text-gray-500">Related</h2>
                        </div>
                        {displayPosts.map((relatedPost) => (
                            <a href={`/blog/${blogSlug(relatedPost)}/`} class="blog-row">
                                <div class="min-w-0">
                                    <h3>{relatedPost.data.title}</h3>
                                    <p>{relatedPost.data.description}</p>
                                </div>
                                <div class="blog-row-side">
                                    <time class="font-mono text-[11px] text-gray-500" datetime={relatedPost.data.pubDate.toISOString()}>
                                        {formatDate(relatedPost.data.pubDate)}
                                    </time>
                                    <span class="font-mono text-[11px] text-gray-500">{relatedPost.data.author}</span>
                                    <span class="blog-tags">
                                        {categoriesFor(relatedPost).map((category) => (
                                            <span class:list={['blog-tag', catClass(category)]}>
                                                <i style={`background-color:${topicDot[category] ?? '#a1a1aa'}`} />
                                                {category}
                                            </span>
                                        ))}
                                    </span>
                                </div>
                            </a>
                        ))}
                    </div>
                </section>
            )
        }

        <div class="mx-auto max-w-6xl border-x border-t border-gray-200 p-1 px-3">
            <div aria-hidden="true" class="h-3 [--stripes-color:theme(colors.gray.200)] [background-image:linear-gradient(-45deg,var(--stripes-color)_25%,transparent_25%,transparent_50%,var(--stripes-color)_50%,var(--stripes-color)_75%,transparent_75%,transparent)] [background-size:5px_5px]"></div>
        </div>
        <div aria-hidden="true" class="border-b border-gray-200"></div>

        <section class="scroll-my-16 bg-gray-950 py-12">
            <div aria-hidden="true" class="border-b border-gray-900"></div>
            <div class="mx-auto max-w-6xl border-x border-b border-gray-900 p-1 px-3">
                <div aria-hidden="true" class="h-3 [--stripes-color:theme(colors.white/0.1)] [background-image:linear-gradient(-45deg,var(--stripes-color)_25%,transparent_25%,transparent_50%,var(--stripes-color)_50%,var(--stripes-color)_75%,transparent_75%,transparent)] [background-size:5px_5px]"></div>
            </div>
            <div class="dark mx-auto max-w-6xl border-x border-gray-900 px-3">
                <div class="border-x border-gray-900 px-2 py-12 text-center sm:px-12">
                    <h2 class="mb-3 text-2xl font-bold text-white sm:text-3xl">Put the gate in. Then let them run.</h2>
                    <p class="mx-auto mb-6 max-w-2xl leading-relaxed text-gray-300">Install the open-source proxy, watch real traffic, then add the rules your agents need.</p>

                    <div class="mt-8 flex w-full flex-col items-center justify-center gap-7 sm:mt-10 sm:flex-row sm:gap-2.5">
                        <a href={`${SITE_GITHUB}/blob/main/docs/getting-started.md`} target="_blank" rel="noopener noreferrer" class={buttonVariants({ size: 'default', className: 'group w-full cursor-pointer gap-2 !rounded-full bg-gray-900 p-3 px-4 hover:bg-main-500 sm:w-auto sm:shrink-0 dark:bg-white dark:text-gray-900 dark:hover:bg-main-400 dark:hover:text-white' })} data-test="cta-get-started">
                            Read the 5-minute setup
                            <span class="hidden size-5 items-center justify-center rounded-full bg-white/10 transition-all duration-300 group-hover:translate-x-1.5 group-hover:bg-white/20 sm:flex dark:bg-gray-900/10 dark:group-hover:bg-white/20">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" class="size-3.5" aria-hidden="true">
                                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m10 16 4-4-4-4"></path>
                                </svg>
                            </span>
                        </a>
                        <CopyInstallCommand wrapClass="w-full sm:w-auto" class="inline-flex h-10 w-full cursor-pointer items-center justify-center rounded-full border border-gray-300 bg-white px-5 shadow-sm transition hover:bg-gray-50 sm:w-auto" data-test="cta-copy-command">
                            <code class="font-mono text-xs font-normal text-gray-900">{INSTALL_COMMAND}</code>
                        </CopyInstallCommand>
                    </div>
                </div>
            </div>
            <div class="mx-auto max-w-6xl border-x border-t border-gray-900 p-1 px-3">
                <div aria-hidden="true" class="h-3 [--stripes-color:theme(colors.white/0.1)] [background-image:linear-gradient(-45deg,var(--stripes-color)_25%,transparent_25%,transparent_50%,var(--stripes-color)_50%,var(--stripes-color)_75%,transparent_75%,transparent)] [background-size:5px_5px]"></div>
            </div>
            <div aria-hidden="true" class="border-b border-gray-900"></div>
        </section>
    </main>
</Layout>

<script>
    const tocLinks = document.querySelectorAll('.toc-link') as NodeListOf<HTMLAnchorElement>
    const headings = document.querySelectorAll('.article-prose h2[id]') as NodeListOf<HTMLHeadingElement>

    let isClickNavigating = false

    const setActiveLink = (hash: string): void => {
        tocLinks.forEach((link) => {
            link.classList.toggle('active', link.getAttribute('href') === hash)
        })
    }

    if (tocLinks.length > 0 && headings.length > 0) {
        tocLinks.forEach((link) => {
            link.addEventListener('click', () => {
                const href = link.getAttribute('href')
                if (href) {
                    isClickNavigating = true
                    setActiveLink(href)
                    setTimeout(() => {
                        isClickNavigating = false
                    }, 150)
                }
            })
        })

        const observer = new IntersectionObserver(
            (entries) => {
                if (isClickNavigating) return
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        const id = entry.target.getAttribute('id')
                        if (id) setActiveLink(`#${id}`)
                    }
                })
            },
            { rootMargin: '-20% 0px -70% 0px', threshold: 0 }
        )

        headings.forEach((heading) => observer.observe(heading))

        const hash = window.location.hash
        if (hash) {
            setActiveLink(hash)
        } else {
            tocLinks[0].classList.add('active')
        }
    }

    const linkedInBtn = document.querySelector('[data-share="linkedin"]') as HTMLAnchorElement | null
    linkedInBtn?.addEventListener('click', (event) => {
        const webUrl = linkedInBtn.href
        const userAgent = navigator.userAgent
        const isAndroid = /Android/i.test(userAgent)
        const isIOS = /iPhone|iPad|iPod/i.test(userAgent)

        if (!isAndroid && !isIOS) {
            event.preventDefault()
            window.open(webUrl, '_blank', 'noopener,noreferrer')
            return
        }

        event.preventDefault()

        if (isAndroid) {
            const encodedPage = encodeURIComponent(window.location.href)
            window.location.href = `intent://www.linkedin.com/sharing/share-offsite/?url=${encodedPage}#Intent;scheme=https;package=com.linkedin.android;S.browser_fallback_url=${encodeURIComponent(webUrl)};end`
            return
        }

        const startedAt = Date.now()
        window.location.href = `linkedin://shareArticle?mini=true&url=${encodeURIComponent(window.location.href)}`
        window.setTimeout(() => {
            if (document.visibilityState === 'visible' && Date.now() - startedAt < 2500) {
                window.location.href = webUrl
            }
        }, 800)
    })
</script>
