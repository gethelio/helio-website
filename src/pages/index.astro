---
import Layout from '../layouts/Layout.astro'
import FAQs from './../components/Faqs.astro'
import { HelioInAction } from '../components/helio-in-action'
import { WhyHelioExists } from '../components/why-helio-exists'
import HelioFeaturesGrid from '../components/FeaturesGrid.astro'
import PlatformLogos from '../components/PlatformLogos.astro'
import CopyInstallCommand, { INSTALL_COMMAND } from '../components/CopyInstallCommand.astro'
import { buttonVariants } from '@/components/ui/button'
import { SITE_DESCRIPTION, SITE_GITHUB, SITE_TITLE } from '../const'
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
    <main class="duration-150">
        <section id="home" class="relative mx-auto max-w-5xl px-4 pt-36 lg:px-0">
            <div class="absolute -z-10 h-full w-full scale-[0.8] bg-[radial-gradient(#e5e7eb_1px,transparent_1px)] [background-size:16px_16px] [mask-image:radial-gradient(ellipse_50%_50%_at_50%_50%,#000_70%,transparent_100%)]"></div>
            <h1 class="text-title mx-auto text-center text-4xl font-semibold sm:mt-12 sm:text-6xl">Govern the action.<br /> Not the prompt.</h1>
            <p class="text-body mx-auto my-8 max-w-3xl text-center">Helio enforces policy on MCP tool calls before they reach your servers. Set spend limits, require evidence or approval, and keep a durable audit trail. No agent or server code changes.</p>
            <div class="mx-auto mt-12 max-w-6xl px-3">
                <div class="px-2 sm:px-12">
                    <div class="flex w-full flex-col items-center justify-center gap-7 sm:flex-row sm:gap-2.5">
                        <a
                            href={`${SITE_GITHUB}/blob/main/docs/getting-started.md`}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="group inline-flex h-10 w-full cursor-pointer items-center justify-center gap-2 whitespace-nowrap rounded-full bg-gray-900 p-3 px-4 text-sm font-medium text-white transition-colors hover:bg-main-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gray-950 focus-visible:ring-offset-2 sm:w-auto sm:shrink-0 dark:bg-white dark:text-gray-900 dark:hover:bg-main-400 dark:hover:text-white"
                            data-test="citation-check-button"
                        >
                            Read the 5-minute setup
                            <span class="hidden size-5 items-center justify-center rounded-full bg-white/10 transition-all duration-300 group-hover:translate-x-1.5 group-hover:bg-white/20 sm:flex dark:bg-gray-900/10 dark:group-hover:bg-white/20">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" class="size-3.5" aria-hidden="true">
                                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m10 16 4-4-4-4"></path>
                                </svg>
                            </span>
                        </a>
                        <CopyInstallCommand wrapClass="w-full sm:w-auto" class="inline-flex h-10 w-full cursor-pointer items-center justify-center rounded-full border border-gray-300 bg-white px-5 shadow-sm transition hover:bg-gray-50 sm:w-auto" data-test="hero-copy-command">
                            <code class="font-mono text-xs font-normal text-gray-900">{INSTALL_COMMAND}</code>
                        </CopyInstallCommand>
                    </div>

                    <span class="text-caption mx-auto mt-6 block max-w-xl text-center text-xs">We also maintain the <a href="https://github.com/gethelio/agent-incident-log" target="_blank" rel="noopener noreferrer" class="font-bold underline-offset-2 hover:underline">Agent Incident Log</a>: a public, sourced record of real incidents involving AI agents with access to tools.</span>
                </div>
            </div>
        </section>

        <!--  Helio in action -->
        <section id="helio-in-action" class="relative mt-8 scroll-my-16 border-y sm:mt-16">
            <div aria-hidden="true" class="absolute inset-x-0 -top-36 -z-10 mx-auto h-36 max-w-2xl rounded-t-full bg-gradient-to-b from-white to-main-100 blur-3xl"></div>
            <div class="relative mx-auto max-w-6xl border-x px-3">
                <div class="border-x">
                    <div aria-hidden="true" class="h-3 invert [--stripes-color:theme(colors.white/0.05)] [background-image:linear-gradient(-45deg,var(--stripes-color)_25%,transparent_25%,transparent_50%,var(--stripes-color)_50%,var(--stripes-color)_75%,transparent_75%,transparent)] [background-size:5px_5px]"></div>
                    <HelioInAction client:load />
                </div>
            </div>
        </section>

        <!-- Agent platform logos -->
        <section>
            <div class="mx-auto max-w-6xl border-x px-3">
                <div class="border-x pb-16 pt-12 sm:pb-24 sm:pt-20">
                    <PlatformLogos />
                </div>
            </div>
        </section>

        <!-- Why Helio exists -->
        <section id="why-helio-exists" class="relative scroll-mt-28">
            <div class="mx-auto max-w-6xl border-x px-3">
                <div class="border-x border-t">
                    <WhyHelioExists />
                </div>
            </div>
        </section>

        <!-- How it works -->
        <section id="how-it-works" class="relative scroll-mt-28">
            <div class="mx-auto max-w-6xl border-x px-3">
                <div class="border-x border-t px-4 py-16 sm:px-8 sm:py-20 md:px-12 md:py-24">
                    <p class="mb-2.5 font-mono text-[10px] font-medium uppercase tracking-[0.12em] text-main-500">How it works</p>
                    <h2 class="text-2xl font-semibold tracking-tight text-gray-900 md:text-3xl">In the path. Not in the prompt.</h2>
                    <p class="mt-3.5 max-w-xl text-[15px] leading-relaxed text-gray-600">Point your MCP client at Helio, then point Helio at your server. Your agent code and MCP server stay as they are.</p>

                    <div class="mt-12 grid gap-10 md:grid-cols-[1fr_auto_1fr_auto_1fr] md:gap-0">
                        <div class="md:pr-8">
                            <div class="mb-2.5 font-mono text-[11px] tracking-[0.08em] text-main-500">01</div>
                            <h3 class="mb-2 text-lg font-semibold tracking-tight text-gray-900">Connect Helio</h3>
                            <p class="text-sm leading-relaxed text-gray-600">Run init, set your upstream MCP server, and start Helio. Then change your client's MCP URL to Helio. No agent or server code changes.</p>
                        </div>
                        <div class="hidden w-px bg-gradient-to-b from-transparent via-gray-300 to-transparent md:block" aria-hidden="true"></div>
                        <div class="md:px-8">
                            <div class="mb-2.5 font-mono text-[11px] tracking-[0.08em] text-main-500">02</div>
                            <h3 class="mb-2 text-lg font-semibold tracking-tight text-gray-900">Watch before you block</h3>
                            <p class="text-sm leading-relaxed text-gray-600">The generated config starts with no active policy rules. Calls keep flowing while Helio records what your agents actually do. Use that trail to decide what needs a rule.</p>
                        </div>
                        <div class="hidden w-px bg-gradient-to-b from-transparent via-gray-300 to-transparent md:block" aria-hidden="true"></div>
                        <div class="md:pl-8">
                            <div class="mb-2.5 font-mono text-[11px] tracking-[0.08em] text-main-500">03</div>
                            <h3 class="mb-2 text-lg font-semibold tracking-tight text-gray-900">Add rules when you're ready</h3>
                            <p class="text-sm leading-relaxed text-gray-600">Add rules to the same <code class="font-mono text-[13px] text-gray-800">helio.yaml</code>. Changes hot-reload. Deny calls, set limits, require approval or evidence, and block tool drift. When Helio owns the path, a blocked call never reaches the server.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Helio features grid -->
        <section id="features" class="relative scroll-mt-28">
            <div class="mx-auto max-w-6xl border-x px-3">
                <div class="border-x border-t px-4 py-16 sm:px-8 sm:py-20 md:px-12 md:py-24">
                    <p class="mb-2.5 font-mono text-[10px] font-medium uppercase tracking-[0.12em] text-main-500">Features</p>
                    <h2 class="text-2xl font-semibold tracking-tight text-gray-900 md:text-3xl">All the controls. One YAML.</h2>
                    <p class="mt-3.5 max-w-2xl text-[15px] leading-relaxed text-gray-600">Write policy in one YAML file and hot-reload changes. Use dry-run to test a decision without forwarding the call. Every MCP client meets the same policy at Helio.</p>

                    <div class="-mx-4 mt-12 sm:-mx-8 md:-mx-12">
                        <HelioFeaturesGrid />
                    </div>
                </div>
            </div>
            <div class="mx-auto max-w-6xl border-x border-t border-gray-200 p-1 px-3">
                <div aria-hidden="true" class="h-3 [--stripes-color:theme(colors.gray.200)] [background-image:linear-gradient(-45deg,var(--stripes-color)_25%,transparent_25%,transparent_50%,var(--stripes-color)_50%,var(--stripes-color)_75%,transparent_75%,transparent)] [background-size:5px_5px]"></div>
            </div>
            <div aria-hidden="true" class="border-b border-gray-200"></div>
        </section>

        <!-- Pricing -->
        <section id="pricing" class="my-12 scroll-my-32 md:my-20 lg:my-32">
            <div class="mx-auto max-w-6xl px-3">
                <div class="px-2 sm:px-12">
                    <h2 class="text-title mb-4 text-center text-3xl font-semibold md:text-4xl">Run it yourself. Bring us in when it matters.</h2>
                    <p class="mx-auto mb-6 max-w-xl text-center md:mb-12">Helio is Apache 2.0 and self-hosted. When agents reach production, we can help you write the policy, assess the controls, and review the deployment.</p>

                    <div class="grid gap-4 lg:grid-cols-[1fr_1.35fr]">
                        <div class="card variant-outlined flex flex-col justify-between space-y-8 p-8">
                            <div class="space-y-6">
                                <div>
                                    <h3 class="text-title font-medium">Open source</h3>
                                    <div class="my-3">
                                        <span class="text-title my-3 align-baseline text-5xl font-medium tracking-tight">Free</span>
                                    </div>
                                    <p class="text-sm">Apache 2.0, self-hosted.</p>
                                </div>
                                <hr class="border-dashed" />
                                <ul class="list-outside list-image-[url(orange-check.svg)] space-y-3 pl-4 text-sm *:pl-2">
                                    <li>Policies, approvals, break-glass</li>
                                    <li>Cumulative budgets and rate limits</li>
                                    <li>Evidence grounding</li>
                                    <li>Tool-definition drift detection</li>
                                    <li>Full audit trail and dashboard</li>
                                    <li>Community support</li>
                                </ul>
                            </div>
                            <CopyInstallCommand wrapClass="w-full sm:w-auto" class="btn variant-outlined intent-gray sz-md w-full py-3 text-sm" data-test="pricing-copy-command">
                                <code class="font-mono text-xs font-normal text-gray-900">{INSTALL_COMMAND}</code>
                            </CopyInstallCommand>
                        </div>
                        <div class="flex flex-col justify-between rounded-2xl bg-[#09090B] p-8 text-white shadow-[0_24px_50px_-28px_rgba(9,9,11,0.55)]">
                            <div>
                                <h3 class="text-lg font-medium">Teams</h3>
                                <div class="my-3 text-5xl font-medium tracking-[-0.04em]">Talk to us</div>
                                <p class="text-sm text-zinc-400">For teams and agencies running agents that touch money, customer data, or production systems.</p>
                                <hr class="my-6 border-dashed border-zinc-800" />
                                <span class="text-sm font-medium">Everything in open source, plus:</span>
                                <ul class="mt-3 list-outside list-image-[url(white-check.svg)] space-y-1 pl-4 text-sm leading-[1.9] text-zinc-300 *:pl-2">
                                    <li>Policy pack for your tools</li>
                                    <li>Written control assessment</li>
                                    <li>Deployment review before you go live</li>
                                    <li>Direct line to the maintainers</li>
                                </ul>
                            </div>
                            <button data-design-partner type="button" class="mt-7 inline-flex w-full items-center justify-center rounded-full bg-white px-[18px] py-3 text-sm font-medium text-[#09090B] transition hover:bg-white/90">Talk to the maintainers</button>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <FAQs />

        <!-- CTA -->
        <section class="scroll-my-16 bg-gray-950 py-12">
            <div aria-hidden="true" class="border-b border-gray-900"></div>
            <div class="mx-auto max-w-6xl border-x border-b border-gray-900 p-1 px-3">
                <div aria-hidden="true" class="h-3 [--stripes-color:theme(colors.white/0.1)] [background-image:linear-gradient(-45deg,var(--stripes-color)_25%,transparent_25%,transparent_50%,var(--stripes-color)_50%,var(--stripes-color)_75%,transparent_75%,transparent)] [background-size:5px_5px]"></div>
            </div>
            <div class="dark mx-auto max-w-6xl border-x border-gray-900 px-3">
                <div class="border-x border-gray-900 px-2 py-12 text-center sm:px-12">
                    <h2 class="mb-3 text-2xl font-bold text-white sm:text-3xl">Put the gate in. Then let them run.</h2>
                    <p class="mx-auto mb-6 max-w-2xl leading-relaxed text-gray-300">Install the open-source proxy, watch real traffic, then add the rules your agents need.</p>

                    <div class="mt-8 flex w-full flex-col items-center justify-center gap-7 sm:mt-10 sm:flex-row sm:gap-2.5">
                        <a href={`${SITE_GITHUB}/blob/main/docs/getting-started.md`} target="_blank" rel="noopener noreferrer" class={buttonVariants({ size: 'default', className: 'group w-full cursor-pointer gap-2 !rounded-full bg-gray-900 p-3 px-4 hover:bg-main-500 sm:w-auto sm:shrink-0 dark:bg-white dark:text-gray-900 dark:hover:bg-main-400 dark:hover:text-white' })} data-test="cta-get-started">
                            Read the 5-minute setup
                            <span class="hidden size-5 items-center justify-center rounded-full bg-white/10 transition-all duration-300 group-hover:translate-x-1.5 group-hover:bg-white/20 sm:flex dark:bg-gray-900/10 dark:group-hover:bg-white/20">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" class="size-3.5" aria-hidden="true">
                                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m10 16 4-4-4-4"></path>
                                </svg>
                            </span>
                        </a>
                        <CopyInstallCommand wrapClass="w-full sm:w-auto" class="inline-flex h-10 w-full cursor-pointer items-center justify-center rounded-full border border-gray-300 bg-white px-5 shadow-sm transition hover:bg-gray-50 sm:w-auto" data-test="cta-copy-command">
                            <code class="font-mono text-xs font-normal text-gray-900">{INSTALL_COMMAND}</code>
                        </CopyInstallCommand>
                    </div>
                </div>
            </div>
            <div class="mx-auto max-w-6xl border-x border-t border-gray-900 p-1 px-3">
                <div aria-hidden="true" class="h-3 [--stripes-color:theme(colors.white/0.1)] [background-image:linear-gradient(-45deg,var(--stripes-color)_25%,transparent_25%,transparent_50%,var(--stripes-color)_50%,var(--stripes-color)_75%,transparent_75%,transparent)] [background-size:5px_5px]"></div>
            </div>
            <div aria-hidden="true" class="border-b border-gray-900"></div>
        </section>
    </main>
</Layout>
